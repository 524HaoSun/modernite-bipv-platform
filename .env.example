# Copy to .env and fill in. Never commit real keys.
NODE_ENV=production
PORT=3456

# OpenAI-compatible LLM gateway used by the AI advisor (/api/studio-advisor)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Server-side Google Solar API key (building insights)
GOOGLE_SOLAR_API_KEY=
# Browser Maps key (Maps JS, Map Tiles, Street View, 3D); restrict by HTTP referrer
GOOGLE_MAPS_BROWSER_KEY=

# Disk cache for PVGIS / NASA POWER weather responses
WEATHER_CACHE_DIR=.cache/weather

# Server data directory (shared projects without D1, rendered PDF reports)
DATA_DIR=.data
# Public origin used when Browser Rendering prints a shared project (e.g. https://modernite.wenda.global)
# Also used as the Google OAuth redirect base when GOOGLE_OAUTH_REDIRECT_URI is unset.
PUBLIC_BASE_URL=

# Google OAuth for /account (and staff who also use customer login). Leave unset until credentials are ready.
# Redirect URI: ${PUBLIC_BASE_URL}/api/control/oauth/google/callback (or set GOOGLE_OAUTH_REDIRECT_URI).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://modernite.wenda.global/api/control/oauth/google/callback

# Optional one-time staff password bootstrap (never commit real passwords).
# Format: username|role|password entries separated by ; or newlines. Roles: editor, approval, super.
# Existing usernames are skipped so restarts do not reset passwords.
# CONTROL_STAFF_SEED=superadmin|super|change-me-now;editor|editor|change-me-now;approval|approval|change-me-now
# Or create accounts with: pnpm exec tsx scripts/provision-staff-password.ts <username> <role> <password>

# Cloudflare: D1 persistent cache + shared projects, Browser Rendering PDFs.
# Token needs D1 Edit and Browser Rendering Edit on the account.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_D1_DATABASE_ID=
# Optional Cloudflare Web Analytics site token (beacon is injected when set)
CF_WEB_ANALYTICS_TOKEN=

# Tip: route the LLM through Cloudflare AI Gateway for caching/logs, e.g.
# LLM_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/custom-<provider>
