# Copy to .env and fill in. Never commit real keys.
NODE_ENV=production
PORT=3456

# OpenAI-compatible LLM gateway used by the AI advisor (/api/studio-advisor)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Server-side Google Solar API key (building insights)
GOOGLE_SOLAR_API_KEY=
# Browser Maps key (Maps JS, Map Tiles, Street View, 3D); restrict by HTTP referrer
GOOGLE_MAPS_BROWSER_KEY=

# Disk cache for PVGIS / NASA POWER weather responses
WEATHER_CACHE_DIR=.cache/weather
