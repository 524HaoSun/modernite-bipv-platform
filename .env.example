# Copy to .env and fill in. Never commit real keys.
NODE_ENV=production
PORT=3456

# OpenAI-compatible LLM gateway used by the AI advisor (/api/studio-advisor)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Server-side Google Solar API key (building insights)
GOOGLE_SOLAR_API_KEY=
# Browser Maps key (Maps JS, Map Tiles, Street View, 3D); restrict by HTTP referrer
GOOGLE_MAPS_BROWSER_KEY=

# Disk cache for PVGIS / NASA POWER weather responses
WEATHER_CACHE_DIR=.cache/weather

# Server data directory (shared projects without D1, rendered PDF reports)
DATA_DIR=.data
# Public origin used when Browser Rendering prints a shared project (e.g. https://modernite.wenda.global)
PUBLIC_BASE_URL=

# Cloudflare: D1 persistent cache + shared projects, Browser Rendering PDFs.
# Token needs D1 Edit and Browser Rendering Edit on the account.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_D1_DATABASE_ID=
# Optional Cloudflare Web Analytics site token (beacon is injected when set)
CF_WEB_ANALYTICS_TOKEN=

# Tip: route the LLM through Cloudflare AI Gateway for caching/logs, e.g.
# LLM_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/custom-<provider>
